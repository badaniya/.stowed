{
  "mcpServers": {
    "context-mode": {
      "command": "context-mode",
      "directTools": true
    },
    "codegraph": {
      "command": "codegraph serve --mcp",
      "lifecycle": "lazy",
      "idleTimeout": 10,
      "requestTimeoutMs": 30000
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--executablePath", "/usr/bin/brave-browser", "--isolated"]
    },
    "codebase-memory-mcp": {
      "command": "/home/badaniya/.local/bin/codebase-memory-mcp"
    }
  }
}
