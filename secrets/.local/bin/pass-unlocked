#!/usr/bin/env python3
"""Interactive pass entrypoint with automatic cache refill and no secret logging."""
import os
import subprocess
import sys
from pathlib import Path

result = subprocess.run([str(Path.home()/'.local/bin/pass-auto-unlock')], capture_output=True)
if result.returncode not in (0, 3):
    print('pass-unlocked: automatic unlock unavailable; verify enrollment', file=sys.stderr)
    sys.exit(1)
os.execv('/usr/bin/pass', ['/usr/bin/pass', *sys.argv[1:]])
