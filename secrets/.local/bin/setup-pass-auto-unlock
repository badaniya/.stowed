#!/usr/bin/env python3
"""Install the root helper and login hook. Does not enroll a passphrase."""
import argparse
import os
import pwd
import re
import subprocess
from datetime import datetime, timezone
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument('--fingerprint', required=True)
args = parser.parse_args()
if not re.fullmatch(r'[A-Fa-f0-9]{40}', args.fingerprint):
    raise SystemExit('Invalid public fingerprint')
os.umask(0o077)
home = Path.home()
user = pwd.getpwuid(os.getuid()).pw_name
if not re.fullmatch(r'[a-z_][a-z0-9_-]*', user):
    raise SystemExit('Unsupported username for sudo rule')
source = Path(__file__).resolve().parents[1]/'lib/dotfiles-secrets/auto_unlock_root.py'
subprocess.run(['sudo', '-n', 'install', '-D', '-o', 'root', '-g', 'root', '-m', '0755', str(source), '/usr/local/libexec/dotfiles-secrets-auto-unlock'], check=True)
rule = user+' ALL=(root) NOPASSWD: NOLOG_INPUT: NOLOG_OUTPUT: /usr/local/libexec/dotfiles-secrets-auto-unlock "", /usr/local/libexec/dotfiles-secrets-auto-unlock --enroll, /usr/local/libexec/dotfiles-secrets-auto-unlock --status\n'
installer = '''import sys,os,subprocess
from pathlib import Path
user=sys.argv[1]
p=Path('/etc/sudoers.d')/('zz-dotfiles-secrets-auto-unlock-'+user)
stage=Path('/etc/sudoers.d')/('.dotfiles-auto-unlock-'+user)
fd=os.open(stage,os.O_WRONLY|os.O_CREAT|os.O_TRUNC|os.O_NOFOLLOW,0o440)
with os.fdopen(fd,'wb') as f:f.write(sys.stdin.buffer.read())
os.chmod(stage,0o440)
r=subprocess.run(['/usr/sbin/visudo','-cf',str(stage)],capture_output=True)
if r.returncode:stage.unlink();raise SystemExit('Invalid restricted sudo policy')
os.replace(stage,p)
'''
subprocess.run(['sudo','-n','/usr/bin/python3','-I','-c',installer,user], input=rule.encode(), check=True)
pam_installer = '''from pathlib import Path
p=Path('/etc/pam.d/common-session')
line='session optional pam_exec.so quiet /usr/local/libexec/dotfiles-secrets-auto-unlock --pam'
text=p.read_text()
if line not in text:
 backup=Path('/etc/pam.d/.common-session.before-dotfiles-auto-unlock')
 if not backup.exists():backup.write_text(text);backup.chmod(0o600)
 p.write_text(text+'\\n# Optional machine-bound GPG unlock after the OS session opens.\\n'+line+'\\n')
'''
subprocess.run(['sudo','-n','/usr/bin/python3','-I','-c',pam_installer], check=True)
profile = home/'.private_bash_profile'
marker = '# BEGIN DOTFILES PASS AUTO UNLOCK'
if marker not in profile.read_text():
    backup = home/'.private-sync-backups'/('profile-before-auto-'+datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')+'.gpg')
    backup.parent.mkdir(mode=0o700, exist_ok=True)
    result = subprocess.run(['gpg','--batch','--trust-model','always','--encrypt','--recipient',args.fingerprint,'--output',str(backup)], input=profile.read_bytes(), capture_output=True)
    if result.returncode:
        raise SystemExit('Encrypted profile backup failed; login hook not changed')
    backup.chmod(0o600)
    block = '''
###############################################################################
# BEGIN DOTFILES PASS AUTO UNLOCK
if [ -x "$HOME/.local/bin/pass-auto-unlock" ]; then
  "$HOME/.local/bin/pass-auto-unlock" --quiet || true
fi
alias pass="$HOME/.local/bin/pass-unlocked"
# END DOTFILES PASS AUTO UNLOCK
'''
    profile.write_text(profile.read_text()+block)
    profile.chmod(0o600)
status = subprocess.run(['sudo','-n','/usr/local/libexec/dotfiles-secrets-auto-unlock','--status'],capture_output=True)
if status.returncode:
    raise SystemExit('Root helper verification failed')
print('Restricted helper installed; login hook installed; '+status.stdout.decode().strip())
print('One-time private GPG enrollment is still required.')
