#!/usr/bin/env python3
"""Create a protected per-host GPG key and initialize plain password-store."""
import getpass
import os
import re
import resource
import socket
import subprocess
import sys
from pathlib import Path


def fail(message):
    print(f'setup-secrets-key: {message}', file=sys.stderr)
    return 1


def is_protected_key(path):
    data = path.read_bytes()
    return b'(protected-private-key' in data or b'(21:protected-private-key' in data


def main():
    if not sys.stdin.isatty():
        return fail('run this in your interactive terminal; never send passwords through chat')
    home = Path.home()
    store = home / '.password-store'
    gnupg = home / '.gnupg'
    if store.is_symlink() or gnupg.is_symlink():
        return fail('existing symlinked store/key directory needs manual review')
    if store.exists() and any(store.iterdir()):
        return fail('existing password store preserved; use its existing key setup')
    gnupg.mkdir(mode=0o700, exist_ok=True)
    gnupg.chmod(0o700)
    env = os.environ.copy()
    env['GNUPGHOME'] = str(gnupg)
    env['PASSWORD_STORE_DIR'] = str(store)
    try:
        env['GPG_TTY'] = os.ttyname(sys.stdin.fileno())
    except OSError:
        pass
    for name in ('GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN'):
        env.pop(name, None)
    try:
        subprocess.run(['pass', '--version'], env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
        result = subprocess.run(['gpg', '--batch', '--with-colons', '--list-secret-keys'],
                                env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=True)
        if any(line.startswith('sec:') for line in result.stdout.splitlines()):
            return fail('existing secret GPG keys preserved; select one with pass init instead')
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        os.umask(0o077)
        password = getpass.getpass('New GPG key passphrase (hidden): ')
        if not password:
            return fail('empty passphrases are not allowed; no key generated')
        if password != getpass.getpass('Confirm GPG key passphrase: '):
            return fail('passphrases differ; no key generated')
        common = ['gpg', '--batch', '--pinentry-mode', 'loopback', '--passphrase-fd', '0', '--status-fd', '1']
        identity = f'Dotfiles secrets {socket.gethostname()} <secrets@{socket.gethostname()}.local>'
        result = subprocess.run([*common, '--quick-generate-key', identity, 'ed25519', 'cert,sign', '1y'],
                                input=password.encode(), env=env, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE, check=True)
        output = result.stdout.decode() if isinstance(result.stdout, bytes) else result.stdout
        match = re.search(r'KEY_CREATED [PB] ([0-9A-F]{40})', output)
        if not match:
            return fail('key creation did not return a fingerprint; inspect existing keys before retrying')
        fingerprint = match.group(1)
        subprocess.run([*common, '--quick-add-key', fingerprint, 'cv25519', 'encr', '1y'],
                       input=password.encode(), env=env, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, check=True)
        del password
        private_files = list((gnupg / 'private-keys-v1.d').glob('*.key'))
        if not private_files or not all(is_protected_key(path) for path in private_files):
            return fail('private-key protection could not be verified; no store initialized')
        subprocess.run(['pass', 'init', fingerprint], env=env, stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, check=True)
        store.chmod(0o700)
        print('Protected signing/certification key and encryption subkey created (one-year expiry).')
        print(f'Public fingerprint: {fingerprint}')
        print('Plain pass store initialized at ~/.password-store. No tokens imported.')
        print('Secure recovery backup is still required before deleting any existing credentials.')
        return 0
    except (OSError, UnicodeError, subprocess.CalledProcessError, EOFError, KeyboardInterrupt):
        return fail('setup stopped; any keys already created are preserved. Review before retrying.')


if __name__ == '__main__':
    sys.exit(main())
