#!/usr/bin/env python3
"""One-time interactive enrollment. Passphrase travels only through memory/pipes."""
import argparse
import getpass
import json
import os
import re
import resource
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path


def clear_key_cache(grips):
    commands = ['CLEAR_PASSPHRASE --mode=normal ' + grip for grip in grips]
    result = subprocess.run(['/usr/bin/gpg-connect-agent', *commands, '/bye'], capture_output=True)
    if result.returncode or b'ERR ' in result.stdout:
        raise ValueError('could not clear encryption-key cache for verification')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--fingerprint', required=True)
    args = parser.parse_args()
    if not os.isatty(0) or not re.fullmatch(r'[A-Fa-f0-9]{40}', args.fingerprint):
        raise ValueError('interactive terminal and primary fingerprint required')
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    os.umask(0o077)
    home = Path.home()
    status = subprocess.run(['sudo', '-n', '/usr/local/libexec/dotfiles-secrets-auto-unlock', '--status'], capture_output=True)
    if status.returncode:
        raise ValueError('privileged enrollment status unavailable')
    try:
        already_enrolled = json.loads(status.stdout).get('enrolled') is True
    except (ValueError, UnicodeError, AttributeError) as error:
        raise ValueError('invalid enrollment status') from error
    if already_enrolled:
        unlocked = subprocess.run([str(home/'.local/bin/pass-auto-unlock')], capture_output=True)
        env = dict(os.environ, PASSWORD_STORE_GPG_OPTS='--batch --pinentry-mode error')
        verified = subprocess.run(['/usr/bin/pass', 'show', 'jira/work/token'], env=env, capture_output=True)
        if unlocked.returncode or verified.returncode:
            raise ValueError('existing enrollment could not be verified')
        print('ENROLLMENT VERIFIED: already enrolled; no passphrase needed.')
        return
    keys = subprocess.check_output(['/usr/bin/gpg', '--with-colons', '--with-keygrip', '--list-secret-keys', args.fingerprint], stderr=subprocess.PIPE).decode()
    grips = []
    encrypting = False
    for line in keys.splitlines():
        fields = line.split(':')
        if fields[0] in ('sec', 'ssb'):
            encrypting = 'e' in fields[11]
        elif fields[0] == 'grp' and encrypting:
            grips.append(fields[9])
    if not grips:
        raise ValueError('no local encryption secret key found')
    config = home/'.gnupg/gpg-agent.conf'
    original = config.read_text() if config.exists() else ''
    backup = home/'.private-sync-backups'/('gpg-agent-before-auto-'+datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S')+'.conf')
    backup.parent.mkdir(mode=0o700, exist_ok=True)
    backup.write_text(original)
    backup.chmod(0o600)
    lines = [line for line in original.splitlines() if not re.match(r'^\s*(?:allow-preset-passphrase|default-cache-ttl|max-cache-ttl)(?:\s|$)', line)]
    # GPG has no documented forever TTL; this exceeds any practical agent lifetime.
    lines += ['allow-preset-passphrase', 'default-cache-ttl 2147483647', 'max-cache-ttl 2147483647']
    config.write_text('\n'.join(lines)+'\n')
    config.chmod(0o600)
    subprocess.run(['/usr/bin/gpgconf', '--reload', 'gpg-agent'], check=True)
    clear_key_cache(grips)
    phrase = getpass.getpass('Existing GPG passphrase (one-time enrollment, not saved plaintext): ')
    if not phrase or '\n' in phrase or '\r' in phrase:
        raise ValueError('invalid passphrase input')
    test = subprocess.run(['/usr/bin/gpg', '--batch', '--pinentry-mode', 'loopback', '--passphrase-fd', '0',
                           '--decrypt', str(home/'.password-store/jira/work/token.gpg')],
                          input=(phrase+'\n').encode(), stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    if test.returncode:
        raise ValueError('passphrase validation failed; no unlock credential enrolled')
    payload = json.dumps({'uid': os.getuid(), 'passphrase': phrase, 'keygrips': grips}).encode()
    enrolled = subprocess.run(['sudo', '-n', '/usr/local/libexec/dotfiles-secrets-auto-unlock', '--enroll'],
                              input=payload, capture_output=True)
    if enrolled.returncode:
        raise ValueError('machine-bound enrollment failed; check privileged helper')
    clear_key_cache(grips)
    unlocked = subprocess.run([str(home/'.local/bin/pass-auto-unlock')], capture_output=True)
    if unlocked.returncode:
        raise ValueError('automatic unlock verification failed')
    env = dict(os.environ, PASSWORD_STORE_GPG_OPTS='--batch --pinentry-mode error')
    verified = subprocess.run(['/usr/bin/pass', 'show', 'jira/work/token'], env=env, capture_output=True)
    if verified.returncode:
        raise ValueError('credential retrieval failed after automatic unlock')
    print('ENROLLMENT VERIFIED: encrypted machine-bound unlock, no second password prompt.')
    print('Signing/certification keys were not preset; encryption keys only.')


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        print('enroll-pass-auto-unlock: '+str(error), file=sys.stderr)
        sys.exit(1)
