#!/usr/bin/env python3
"""Populate this user's GPG cache through the narrowly authorized root helper."""
import subprocess
import sys

if sys.argv[1:] not in ([], ['--quiet']):
    sys.exit(2)
try:
    result = subprocess.run(['sudo', '-n', '/usr/local/libexec/dotfiles-secrets-auto-unlock'], capture_output=True)
    if result.returncode not in (0, 3) and '--quiet' not in sys.argv:
        print('pass-auto-unlock: automatic unlock failed; verify machine-bound enrollment', file=sys.stderr)
    sys.exit(result.returncode)
except OSError:
    if '--quiet' not in sys.argv:
        print('pass-auto-unlock: privileged helper unavailable', file=sys.stderr)
    sys.exit(1)
