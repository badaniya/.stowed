#!/usr/bin/env python3
"""Run Cloud Jira with a pass token scoped to this child process only."""
import json
import os
import re
import stat
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit


def fail(message):
    print('jira-work: ' + message, file=sys.stderr)
    return 1


def private_read(path):
    with path.open() as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
            raise ValueError('unsafe private configuration permissions')
        return stream.read()


def main():
    args = sys.argv[1:]
    if not args:
        return fail('usage: jira-work JIRA_ARGUMENTS...')
    # Config overrides could send this token to another server. Debug could expose headers.
    if any(a in ('init', '--debug', '--config', '-c') or a.startswith(('--config=', '--debug=', '-c')) for a in args):
        return fail('configuration overrides, initialization and debug output are disabled')
    try:
        import yaml
        settings = json.loads(private_read(Path.home() / '.private_jira_work.json'))
        host, secret = settings['host'], settings['secret']
        if not isinstance(host, str) or not re.fullmatch(r'[a-z0-9][a-z0-9.-]*\.atlassian\.net', host):
            raise ValueError('invalid Cloud Jira host')
        if not isinstance(secret, str) or not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9/_.-]*', secret) or '..' in secret:
            raise ValueError('invalid pass reference')
        config, binary = Path(settings['config']), Path(settings['binary'])
        if not config.is_absolute() or not binary.is_absolute():
            raise ValueError('paths must be absolute')
        parsed = yaml.safe_load(private_read(config))
        server = urlsplit(parsed['server'])
        if (server.scheme != 'https' or server.hostname != host or server.port not in (None, 443)
                or server.username or server.password or server.query or server.fragment or server.path not in ('', '/')
                or str(parsed.get('installation')).lower() != 'cloud' or parsed.get('auth_type') != 'basic'):
            raise ValueError('Cloud Jira server/authentication scope mismatch')
        if not binary.is_file() or not os.access(binary, os.X_OK) or binary.resolve() == Path(__file__).resolve():
            raise ValueError('Jira CLI binary unavailable')
    except (OSError, ValueError, TypeError, KeyError, ImportError):
        return fail('configure owner-only ~/.private_jira_work.json and Cloud Jira YAML; Python PyYAML is required')
    automatic = Path.home() / '.local/bin/pass-auto-unlock'
    if automatic.is_file():
        try:
            unlocked = subprocess.run([str(automatic)], capture_output=True)
            if unlocked.returncode not in (0, 3):
                return fail('automatic GPG unlock failed; verify machine enrollment')
        except OSError:
            return fail('automatic GPG unlock helper unavailable')
    env = os.environ.copy()
    for name in ('JIRA_API_TOKEN', 'JIRA_AUTH_TYPE', 'JIRA_CONFIG_FILE'):
        env.pop(name, None)
    if os.isatty(0):
        env['GPG_TTY'] = os.ttyname(0)
    try:
        result = subprocess.run(['pass', 'show', secret], env=env, capture_output=True, text=True)
        if result.returncode:
            return fail('pass could not retrieve the credential; unlock your GPG key privately and retry')
        token = result.stdout.rstrip('\r\n')
        if not token or len(token) > 8192 or any(c.isspace() for c in token):
            return fail('credential must be a nonempty single-line token')
        env.update(JIRA_API_TOKEN=token, JIRA_AUTH_TYPE='basic', JIRA_CONFIG_FILE=str(config))
        os.execve(str(binary), [str(binary), '--config', str(config), *args], env)
    except (OSError, UnicodeError):
        return fail('could not execute pass/Jira CLI')


if __name__ == '__main__':
    sys.exit(main())
