#!/usr/bin/env python3
"""Run gh with one account's pass token, without persisting it in gh config."""
import json
import os
import re
import stat
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit

TOKEN_VARS = ('GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN')
BLOCKED_AUTH = {'login', 'logout', 'refresh', 'switch', 'setup-git', 'token'}


def fail(message):
    print(f'gh-account: {message}', file=sys.stderr)
    return 1


def main():
    if len(sys.argv) < 3:
        return fail('usage: gh-account ACCOUNT GH_ARGUMENTS... (personal, work, enterprise)')
    account, args = sys.argv[1], sys.argv[2:]
    if args[0] == 'auth' and len(args) > 1 and args[1] in BLOCKED_AUTH:
        return fail('manage credentials in pass; native gh token storage/output is disabled here')
    config = Path.home() / '.private_gh_accounts.json'
    try:
        # Read one opened file: permissions and content refer to the same inode.
        with config.open() as stream:
            info = os.fstat(stream.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
                return fail('private account config must be owned by you with mode 0600')
            settings = json.load(stream)[account]
        host, secret = settings['host'], settings['secret']
        if not isinstance(host, str) or not re.fullmatch(r'[a-zA-Z0-9.-]+', host) or host.endswith('.invalid'):
            return fail('configure a valid GitHub host for this account')
        host = host.lower()
        if not isinstance(secret, str) or not re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9/_\-.]*', secret) or '..' in secret:
            return fail('invalid pass secret reference')
    except (OSError, ValueError, KeyError, TypeError):
        return fail('configure this account in ~/.private_gh_accounts.json (references only, no tokens)')
    # Prevent accidentally using this credential with a different explicit host.
    for index, arg in enumerate(args):
        host_flags = ('--hostname', '--host', '-h') if args[0] in ('api', 'auth') else ('--hostname', '--host')
        if arg in host_flags and index + 1 < len(args) and args[index + 1].lower() != host:
            return fail('explicit hostname differs from the selected account')
        repo = None
        if arg in ('--repo', '-R') and index + 1 < len(args):
            repo = args[index + 1]
        elif arg.startswith('--repo='):
            repo = arg.split('=', 1)[1]
        elif arg.startswith('-R') and len(arg) > 2:
            repo = arg[2:]
        if repo is not None:
            parts = repo.split('/')
            if repo.startswith(('http://', 'https://')):
                if urlsplit(repo).hostname != host:
                    return fail('repository host differs from the selected account')
            elif len(parts) >= 3 and parts[0].lower() != host:
                return fail('repository host differs from the selected account')
        if arg.startswith(('--hostname=', '--host=')) and arg.split('=', 1)[1].lower() != host:
            return fail('explicit hostname differs from the selected account')
        if arg.startswith(('http://', 'https://')) and urlsplit(arg).hostname != host:
            return fail('URL host differs from the selected account')
    automatic = Path.home() / '.local/bin/pass-auto-unlock'
    if automatic.is_file():
        try:
            unlocked = subprocess.run([str(automatic)], capture_output=True)
            if unlocked.returncode not in (0, 3):
                return fail('automatic GPG unlock failed; verify machine enrollment')
        except OSError:
            return fail('automatic GPG unlock helper unavailable')
    env = os.environ.copy()
    for variable in TOKEN_VARS:
        env.pop(variable, None)
    env['GH_HOST'] = host
    if os.isatty(0):
        env['GPG_TTY'] = os.ttyname(0)
    try:
        result = subprocess.run(['pass', 'show', secret],
                                env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, check=False)
        if result.returncode:
            return fail('pass could not retrieve the credential; unlock/configure the store and retry')
        token = result.stdout.rstrip('\r\n')
        if not token or len(token) > 8192 or any(c.isspace() for c in token):
            return fail('credential must be a nonempty single-line token')
        env['GH_TOKEN' if host == 'github.com' or host.endswith('.ghe.com') else 'GH_ENTERPRISE_TOKEN'] = token
        os.execvpe('gh', ['gh', *args], env)
    except (OSError, UnicodeError):
        return fail('could not execute pass/gh; verify they are installed')


if __name__ == '__main__':
    sys.exit(main())
