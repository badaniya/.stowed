#!/usr/bin/env python3
"""Create and restore-test an encrypted GPG recovery bundle; never print key data."""
import getpass
import hashlib
import io
import os
import re
import resource
import socket
import subprocess
import sys
import tarfile
import tempfile
from datetime import datetime, timezone
from pathlib import Path


def gpg_password(args, password, env, data=None):
    if not password or len(password.encode()) > 4096 or '\n' in password or '\r' in password:
        raise ValueError('a nonempty single-line passphrase is required')
    read_fd, write_fd = os.pipe()
    try:
        os.write(write_fd, password.encode() + b'\n')
        os.close(write_fd)
        write_fd = -1
        result = subprocess.run(['gpg', '--batch', '--yes', '--pinentry-mode', 'loopback',
                                 '--passphrase-fd', str(read_fd), *args],
                                input=data, env=env, pass_fds=(read_fd,),
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True)
        return result.stdout
    finally:
        os.close(read_fd)
        if write_fd != -1:
            os.close(write_fd)


def archive_bytes(files):
    stream = io.BytesIO()
    with tarfile.open(fileobj=stream, mode='w') as archive:
        for name, content in files.items():
            info = tarfile.TarInfo(name)
            info.size = len(content)
            info.mode = 0o600
            archive.addfile(info, io.BytesIO(content))
    return stream.getvalue()


def main():
    if not sys.stdin.isatty():
        print('Use your interactive terminal; never supply passphrases through chat.', file=sys.stderr)
        return 1
    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
    os.umask(0o077)
    home = Path.home()
    host = socket.gethostname()
    env = os.environ.copy()
    env['GNUPGHOME'] = str(home / '.gnupg')
    for name in ('GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN'):
        env.pop(name, None)
    try:
        fingerprint = (home / '.password-store/hosts' / host / '.gpg-id').read_text().strip()
        if not re.fullmatch('[0-9A-F]{40}', fingerprint):
            raise ValueError('host recipient is not one fingerprint')
        print('The recovery bundle will use your existing GPG passphrase. No plaintext key export will be written.')
        password = getpass.getpass('Existing GPG passphrase (hidden): ')
        secret = gpg_password(['--armor', '--export-secret-keys', fingerprint], password, env)
        if not secret:
            raise ValueError('empty secret-key export')
        public = subprocess.run(['gpg', '--batch', '--armor', '--export', fingerprint],
                                env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=True).stdout
        files = {'secret-key.asc': secret, 'public-key.asc': public,
                 'fingerprint.txt': (fingerprint + '\n').encode()}
        revocation = home / '.gnupg/openpgp-revocs.d' / (fingerprint + '.rev')
        if revocation.exists():
            files['revocation.asc'] = revocation.read_bytes()
        plain = archive_bytes(files)
        encrypted = gpg_password(['--symmetric', '--cipher-algo', 'AES256'], password, env, plain)
        recovered = gpg_password(['--decrypt'], password, env, encrypted)
        if recovered != plain:
            raise ValueError('bundle decrypt verification failed')
        # Restore into a separate keyring and prove its encryption subkey works.
        with tempfile.TemporaryDirectory(prefix='pass-key-restore-') as folder:
            restore_env = dict(env, GNUPGHOME=folder)
            try:
                gpg_password(['--import'], password, restore_env, secret)
                test_plain = b'nonsecret-recovery-verification'
                test_cipher = subprocess.run(['gpg', '--batch', '--yes', '--trust-model', 'always',
                                              '--recipient', fingerprint, '--encrypt'],
                                             input=test_plain, env=restore_env, stdout=subprocess.PIPE,
                                             stderr=subprocess.PIPE, check=True).stdout
                if gpg_password(['--decrypt'], password, restore_env, test_cipher) != test_plain:
                    raise ValueError('restored key cannot decrypt test data')
                keys = list((Path(folder) / 'private-keys-v1.d').glob('*.key'))
                if not keys or any(b'protected-private-key' not in p.read_bytes() for p in keys):
                    raise ValueError('restored private keys are not protected')
            finally:
                subprocess.run(['gpgconf', '--kill', 'gpg-agent'], env=restore_env,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
        del password, secret, plain, recovered, files
        directory = home / '.private-pass-recovery' / host
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        directory.chmod(0o700)
        filename = directory / (datetime.now(timezone.utc).strftime('%Y%m%d-%H%M%S') + '.tar.gpg')
        fd = os.open(filename, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, 'wb') as output:
            output.write(encrypted)
            output.flush()
            os.fsync(output.fileno())
        print('Encrypted recovery bundle created; decryption and restored-key test passed.')
        print(f'Bundle: {filename}')
        print(f'SHA256: {hashlib.sha256(encrypted).hexdigest()}')
        print('Keep this bundle off the VM and remember its passphrase. No tokens were migrated.')
        return 0
    except (OSError, ValueError, subprocess.CalledProcessError, EOFError, KeyboardInterrupt):
        print('Recovery backup failed or was cancelled. No existing keys or credentials were removed.', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
