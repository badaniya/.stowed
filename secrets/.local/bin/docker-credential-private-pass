#!/usr/bin/env python3
"""Route Docker's pass credential helper to this host's consolidated vault namespace."""
import os
import shutil
import socket
import subprocess
import sys
from pathlib import Path


def main():
    namespace = Path.home() / '.password-store/hosts' / socket.gethostname()
    if not (namespace / '.gpg-id').is_file():
        print('Docker pass namespace is not initialized; no credentials were changed.', file=sys.stderr)
        return 1
    backend = shutil.which('docker-credential-pass')
    if backend is None or Path(backend).resolve() == Path(__file__).resolve():
        print('Original docker-credential-pass backend is missing or recursive.', file=sys.stderr)
        return 1
    automatic = Path.home() / '.local/bin/pass-auto-unlock'
    if automatic.is_file():
        try:
            unlocked = subprocess.run([str(automatic)], capture_output=True)
            if unlocked.returncode not in (0, 3):
                print('Automatic GPG unlock failed; verify machine enrollment.', file=sys.stderr)
                return 1
        except OSError:
            print('Automatic GPG unlock helper unavailable.', file=sys.stderr)
            return 1
    env = os.environ.copy()
    env['PASSWORD_STORE_DIR'] = str(namespace)
    try:
        os.execve(backend, [backend, *sys.argv[1:]], env)
    except OSError:
        print('Could not execute the original Docker credential helper.', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
