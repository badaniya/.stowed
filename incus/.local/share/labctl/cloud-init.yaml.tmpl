#cloud-config
package_update: true
packages:
  - docker.io
  - docker-compose-v2
users:
  - name: __LABCTL_INSTANCE_USER__
    groups: [docker]
    shell: /bin/bash
runcmd:
  - install -d -o __LABCTL_INSTANCE_USER__ -g __LABCTL_INSTANCE_USER__ /home/__LABCTL_INSTANCE_USER__
  - systemctl enable --now docker
