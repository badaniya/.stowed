LABCTL_WORKSPACE_ROOT=/home/badaniya/workspace/badaniya
LABCTL_MASTER_ROOT=/home/badaniya/workspace/badaniya/master
LABCTL_AGENT_BRIDGE=agentbr0
LABCTL_AGENT_CIDR=10.77.0.0/16
LABCTL_AGENT_GATEWAY=10.77.0.1
LABCTL_IP_POOL_START=10.77.10.11
LABCTL_IP_POOL_END=10.77.10.20
LABCTL_LAB_ROUTE_GATEWAY=10.23.71.1
LABCTL_INSTANCE_IMAGE=local:golden:2026-10-18-8
LABCTL_INSTANCE_USER=badaniya
LABCTL_GO_VERSION=1.26.6
LABCTL_INTERNAL_INSECURE_REGISTRIES=engartifacts1.extremenetworks.com:8090,engartifacts1.extremenetworks.com:8099,engartifacts1.extremenetworks.com:8094,engartifacts1.extremenetworks.com:8118
LABCTL_DEVICE_TCP_PORTS=443,8090,8091,9000,9095,50055,50091
LABCTL_STACK_UP_COMMAND=IMAGE_IMPORT=false make -C PlatformCommonModels/scripts/development setup-config-db && make -C PlatformServices/scripts/development build-tagging && make -C PlatformServices/scripts/development start-tagging && make -C GoDCApp/NVO/scripts/development start-infra && make -C GoDCApp/NVO/scripts/development build && make -C GoDCApp/NVO/scripts/development start-services
LABCTL_STACK_DOWN_COMMAND=make -C GoDCApp/NVO/scripts/development stop-all && make -C PlatformServices/scripts/development stop-tagging
LABCTL_STACK_HEALTH_COMMAND=docker info
LABCTL_WORKTREE_CREATE_HOOK=/bin/false
LABCTL_WORKTREE_REMOVE_HOOK=/bin/false
LABCTL_HARNESS_REPO_NAMES=GoDCApp,PlatformCommonModels,PlatformServices,PlatformServicesCommon
LABCTL_GIT_HOST=github.extremenetworks.com
LABCTL_GIT_CREDENTIAL_NAME=git-module-token
LABCTL_DOCKER_DNS_SERVERS=134.141.36.32,134.141.36.38,10.6.16.32
LABCTL_LOGGO_TEMPLATE_PATH=/home/badaniya/.private-nvo-loggo.tpl
LABCTL_STAGE_SHARED_COMMAND=:
LABCTL_STAGE_PCM_DB_COMMAND=cd PlatformCommonModels/scripts/development && IMAGE_IMPORT=false make setup-config-db
LABCTL_STAGE_PLATFORM_TAGGING_BUILD_COMMAND=cd PlatformServices/scripts/development && make build-tagging
LABCTL_STAGE_PLATFORM_TAGGING_START_COMMAND=cd PlatformServices/scripts/development && make start-tagging
LABCTL_STAGE_GODCAPP_BUILD_COMMAND=cd GoDCApp/NVO/scripts/development && make build
LABCTL_STAGE_GODCAPP_INFRA_COMMAND=cd GoDCApp/NVO/scripts/development && { grep -q '^XIQ_THREAD_POOL ?=' Makefile || sed -i '/^XIQEmulatorKafkaContainerName=/a XIQ_THREAD_POOL ?= 1000' Makefile; } && sed -i 's/thread-pool=1000/thread-pool=$(XIQ_THREAD_POOL)/' Makefile && make start-infra
LABCTL_STAGE_GODCAPP_SERVICES_COMMAND=cd GoDCApp/NVO/scripts/development && make start-services
LABCTL_NVO_ENV_SOURCE_PATH=/home/badaniya/.private_bash_profile
LABCTL_INCUS_PROJECT=agent-sandbox
