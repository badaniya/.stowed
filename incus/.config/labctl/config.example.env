# Copy to ~/.config/labctl/config.env, replace every value, then chmod 600 it.
LABCTL_WORKSPACE_ROOT=REPLACE_WITH_ABSOLUTE_WORKSPACE_ROOT
LABCTL_MASTER_ROOT=REPLACE_WITH_ABSOLUTE_MASTER_ROOT
LABCTL_AGENT_BRIDGE=REPLACE_WITH_AGENT_BRIDGE
LABCTL_AGENT_CIDR=REPLACE_WITH_AGENT_CIDR
LABCTL_AGENT_GATEWAY=REPLACE_WITH_AGENT_GATEWAY
LABCTL_IP_POOL_START=REPLACE_WITH_POOL_START
LABCTL_IP_POOL_END=REPLACE_WITH_POOL_END
LABCTL_LAB_ROUTE_GATEWAY=REPLACE_WITH_LAB_ROUTE_GATEWAY
LABCTL_INSTANCE_IMAGE=REPLACE_WITH_INSTANCE_IMAGE
LABCTL_INSTANCE_USER=REPLACE_WITH_INSTANCE_USER
# Use a numeric semantic version, for example MAJOR.MINOR.PATCH, with no v prefix.
LABCTL_GO_VERSION=REPLACE_WITH_GO_VERSION
# Comma-separated internal registry host:port endpoints only (no scheme, path,
# credentials, or whitespace). labctl configures them as Docker insecure registries.
LABCTL_INTERNAL_INSECURE_REGISTRIES=REPLACE_WITH_COMMA_SEPARATED_INTERNAL_REGISTRY_ENDPOINTS
# Comma-separated IPv4 Docker DNS servers only (no whitespace or duplicates).
LABCTL_DOCKER_DNS_SERVERS=REPLACE_WITH_COMMA_SEPARATED_DOCKER_DNS_SERVERS
# Stack hooks are trusted local private configuration. `labctl bootstrap <ticket>` runs the
# stack-up hook once after the sandbox is ready; hooks run only inside the sandbox from its
# mounted ticket root. Do not store application details or credentials in this package.
LABCTL_DEVICE_TCP_PORTS=REPLACE_WITH_COMMA_SEPARATED_PORTS
LABCTL_STACK_UP_COMMAND=REPLACE_WITH_STACK_UP_COMMAND
LABCTL_STACK_DOWN_COMMAND=REPLACE_WITH_STACK_DOWN_COMMAND
LABCTL_STACK_HEALTH_COMMAND=REPLACE_WITH_STACK_HEALTH_COMMAND
LABCTL_WORKTREE_CREATE_HOOK=REPLACE_WITH_CREATE_HOOK
LABCTL_WORKTREE_REMOVE_HOOK=REPLACE_WITH_REMOVE_HOOK
LABCTL_HARNESS_REPO_NAMES=REPLACE_WITH_HARNESS_REPOSITORIES

# Git host only; labctl obtains the credential from the host Git credential helper.
LABCTL_GIT_HOST=REPLACE_WITH_GIT_HOST
# Optional; defaults to git-module-token when omitted from the active configuration.
LABCTL_GIT_CREDENTIAL_NAME=git-module-token
# Optional absolute owner-only Loggo template path. labctl delivers its content
# through an Incus credential; do not commit the source template.
LABCTL_LOGGO_TEMPLATE_PATH=REPLACE_WITH_ABSOLUTE_LOGGO_TEMPLATE_PATH
