# Copy to ~/.config/labctl/config.env, replace every value, then chmod 600 it.
LABCTL_WORKSPACE_ROOT=REPLACE_WITH_ABSOLUTE_WORKSPACE_ROOT
LABCTL_MASTER_ROOT=REPLACE_WITH_ABSOLUTE_MASTER_ROOT
LABCTL_AGENT_BRIDGE=REPLACE_WITH_AGENT_BRIDGE
LABCTL_AGENT_CIDR=REPLACE_WITH_AGENT_CIDR
LABCTL_AGENT_GATEWAY=REPLACE_WITH_AGENT_GATEWAY
LABCTL_IP_POOL_START=REPLACE_WITH_POOL_START
LABCTL_IP_POOL_END=REPLACE_WITH_POOL_END
LABCTL_LAB_ROUTE_GATEWAY=REPLACE_WITH_LAB_ROUTE_GATEWAY
LABCTL_INSTANCE_IMAGE=REPLACE_WITH_INSTANCE_IMAGE
# Dedicated private Incus project for all agent sandbox resources.
LABCTL_INCUS_PROJECT=agent-sandbox
LABCTL_INSTANCE_USER=REPLACE_WITH_INSTANCE_USER
# Use a numeric semantic version, for example MAJOR.MINOR.PATCH, with no v prefix.
LABCTL_GO_VERSION=REPLACE_WITH_GO_VERSION
# Comma-separated internal registry host:port endpoints only (no scheme, path,
# credentials, or whitespace). labctl configures them as Docker insecure registries.
LABCTL_INTERNAL_INSECURE_REGISTRIES=REPLACE_WITH_COMMA_SEPARATED_INTERNAL_REGISTRY_ENDPOINTS
# Comma-separated IPv4 Docker DNS servers only (no whitespace or duplicates).
LABCTL_DOCKER_DNS_SERVERS=REPLACE_WITH_COMMA_SEPARATED_DOCKER_DNS_SERVERS
# Stack hooks are trusted local private configuration. `labctl bootstrap <ticket>` runs the
# selected stack-up hook once after the sandbox is ready. Legacy hooks run from
# the mounted ticket root; monorepo hooks run from the detected monorepo directory.
# Do not store application details or credentials in this package.
LABCTL_DEVICE_TCP_PORTS=REPLACE_WITH_COMMA_SEPARATED_PORTS
LABCTL_STACK_UP_COMMAND=REPLACE_WITH_STACK_UP_COMMAND
LABCTL_STACK_DOWN_COMMAND=REPLACE_WITH_STACK_DOWN_COMMAND
LABCTL_STACK_HEALTH_COMMAND=REPLACE_WITH_STACK_HEALTH_COMMAND
# Optional monorepo lifecycle overrides. Omit to use the monorepo defaults;
# a full startup override replaces the monorepo stage sequence.
# LABCTL_MONO_STACK_UP_COMMAND=REPLACE_WITH_MONOREPO_STACK_UP_COMMAND
# LABCTL_MONO_STACK_DOWN_COMMAND=REPLACE_WITH_MONOREPO_STACK_DOWN_COMMAND
# LABCTL_MONO_STACK_HEALTH_COMMAND=REPLACE_WITH_MONOREPO_STACK_HEALTH_COMMAND
# Parallel startup stages. Keep the product-specific commands only in this
# owner-only private config; each stage executes inside the sandbox.
LABCTL_STAGE_SHARED_COMMAND=REPLACE_WITH_SHARED_STAGE_COMMAND
LABCTL_STAGE_DB_COMMAND=REPLACE_WITH_DATABASE_STAGE_COMMAND
LABCTL_STAGE_PLATFORM_BUILD_COMMAND=REPLACE_WITH_PLATFORM_BUILD_STAGE_COMMAND
LABCTL_STAGE_PLATFORM_START_COMMAND=REPLACE_WITH_PLATFORM_START_STAGE_COMMAND
LABCTL_STAGE_APP_BUILD_COMMAND=REPLACE_WITH_APP_BUILD_STAGE_COMMAND
LABCTL_STAGE_APP_INFRA_COMMAND=REPLACE_WITH_APP_INFRA_STAGE_COMMAND
LABCTL_STAGE_APP_SERVICES_COMMAND=REPLACE_WITH_APP_SERVICES_STAGE_COMMAND
# Optional monorepo stage overrides (same stage names, LABCTL_MONO_STAGE_<STAGE>_COMMAND).
# LABCTL_MONO_STAGE_DB_COMMAND=REPLACE_WITH_MONOREPO_DATABASE_STAGE_COMMAND
LABCTL_WORKTREE_CREATE_HOOK=REPLACE_WITH_CREATE_HOOK
LABCTL_WORKTREE_REMOVE_HOOK=REPLACE_WITH_REMOVE_HOOK
LABCTL_HARNESS_REPO_NAMES=REPLACE_WITH_HARNESS_REPOSITORIES

# Git host only; labctl obtains the credential from the host Git credential helper.
LABCTL_GIT_HOST=REPLACE_WITH_GIT_HOST
# Optional; defaults to git-module-token when omitted from the active configuration.
LABCTL_GIT_CREDENTIAL_NAME=git-module-token
# Optional absolute owner-only Loggo template path. labctl delivers its content
# through an Incus credential; do not commit the source template.
LABCTL_LOGGO_TEMPLATE_PATH=REPLACE_WITH_ABSOLUTE_LOGGO_TEMPLATE_PATH
# Optional absolute, owner-only host profile from which labctl parses only the
# LABCTL_MONOREPO_ENV_SECTION section. It is never sourced or evaluated.
LABCTL_MONOREPO_ENV_SOURCE_PATH=REPLACE_WITH_ABSOLUTE_PRIVATE_PROFILE
LABCTL_MONOREPO_ENV_SECTION=REPLACE_WITH_PROFILE_SECTION_HEADER
# Space-separated variable names.
LABCTL_MONOREPO_ENV_ALLOWED=REPLACE_WITH_COPIED_VARIABLES
LABCTL_MONOREPO_ENV_SKIPPED=REPLACE_WITH_HOST_ONLY_VARIABLES
LABCTL_MONOREPO_ENV_HOST_IP_VARS=REPLACE_WITH_SANDBOX_IP_VARIABLES
LABCTL_MONOREPO_ENV_INSTANCE_ID_VAR=REPLACE_WITH_INSTANCE_ID_VARIABLE
# Space-separated NAME=value pairs appended last.
LABCTL_MONOREPO_ENV_FIXED=REPLACE_WITH_FIXED_PAIRS
# Space-separated service log directory names, created as /var/log/<name> in the guest.
LABCTL_MONOREPO_SERVICE_LOG_DIRS=REPLACE_WITH_LOG_DIRECTORIES
