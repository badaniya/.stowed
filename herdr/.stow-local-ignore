# Runtime belongs to Herdr, not Stow. Works with --no-folding deployments.
(^|/)\.gitignore$
^/\.config/herdr/.*\.sock.*$
^/\.config/herdr/.*\.log$
^/\.config/herdr/\.plugins\.lock$
^/\.config/herdr/plugins\.json$
^/\.config/herdr/session.*$
^/\.config/herdr/release-notes\.json$
^/\.config/herdr/plugins/(github|github-installations|\.locks)(/|$)
^/\.config/herdr/plugins/config/cloudmanic\.herdr-plus/projects(/|$)
^/\.config/herdr/plugins/config/usagebar/update-check-state\.json$
